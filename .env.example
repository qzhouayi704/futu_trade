# 富途量化交易系统 - 环境变量配置示例
#
# 使用方法：
# 1. 复制此文件为 .env
# 2. 根据实际情况修改配置值
# 3. 环境变量会覆盖 config.json 中的对应配置
#
# 注意：环境变量仅覆盖部署相关的关键配置，不会覆盖所有配置项

# ==================== 连接配置 ====================
# 富途OpenD主机地址
# FUTU_HOST=127.0.0.1

# 富途OpenD端口
# FUTU_PORT=11111

# 数据库路径
# FUTU_DATABASE_PATH=simple_trade/data/trade.db

# ==================== 交易配置 ====================
# 自动交易开关 (true/false, 1/0, yes/no)
# FUTU_AUTO_TRADE=true

# 数据更新间隔（秒）
# FUTU_UPDATE_INTERVAL=60

# ==================== 监控配置 ====================
# 最大订阅股票数量
# FUTU_MAX_SUBSCRIPTION_STOCKS=300

# ==================== 主力资金流入提醒 ====================
# 热门度+市场宽度门控（默认开启；设为 false 可恢复旧的全池提醒）
# CAPITAL_INFLOW_HOT_GATE_ENABLED=true
# 热门股定义：正常/弱市取同市场成交额前20%，极弱市取前10%；不要求当日先上涨
# CAPITAL_INFLOW_HOT_TURNOVER_PCT=0.80
# CAPITAL_INFLOW_EXTREME_HOT_TURNOVER_PCT=0.90
# 市场状态：正常≥55%，弱市40%-55%，极弱市<40%；有效报价样本至少20只
# CAPITAL_INFLOW_NORMAL_BREADTH=0.55
# CAPITAL_INFLOW_WEAK_BREADTH=0.40
# CAPITAL_INFLOW_MIN_UNIVERSE=20
# 弱/极弱市必须有至少5只同板块报价，并满足板块宽度与个股相对强度
# CAPITAL_INFLOW_MIN_PLATE_SIZE=5
# CAPITAL_INFLOW_NORMAL_PLATE_BREADTH=0.55
# CAPITAL_INFLOW_WEAK_PLATE_BREADTH=0.50
# CAPITAL_INFLOW_EXTREME_PLATE_BREADTH=0.70
# CAPITAL_INFLOW_NORMAL_RELATIVE_STRENGTH_PCT=0.0
# CAPITAL_INFLOW_WEAK_RELATIVE_STRENGTH_PCT=2.50
# CAPITAL_INFLOW_EXTREME_RELATIVE_STRENGTH_PCT=2.50
# 资金流滚动窗口与力度标定统一为10分钟
# CAPITAL_TICK_WINDOW_SEC=600
# 首次强流入后15分钟内出现第二次才升级为买点确认
# CAPITAL_TREND_INFLOW_CONFIRM_SEC=900
# 相邻独立强流入至少间隔5分钟；确认后峰值回撤1.5%提示止盈
# CAPITAL_TREND_INFLOW_COOLDOWN_SEC=300
# CAPITAL_TREND_INFLOW_TRAIL_PCT=0.015
# 确认价格不得低于首次价，且距观察峰值回撤不得超过1%；试仓浮盈1.5%后回撤1%退出
# CAPITAL_TREND_INFLOW_CONFIRM_MAX_PULLBACK_PCT=0.010
# CAPITAL_TREND_INFLOW_WATCH_ACTIVATION_PCT=0.015
# CAPITAL_TREND_INFLOW_WATCH_TRAIL_PCT=0.010
# 正常/弱市资金门槛：净流入≥4倍大单门槛、大买/大卖≥4、力度≥1.5倍
# CAPITAL_TREND_INFLOW_MIN=4.0
# CAPITAL_TREND_INFLOW_BUY_RATIO=4.0
# CAPITAL_TREND_INFLOW_MIN_MULT=1.5
# CAPITAL_TREND_INFLOW_WEAK_MIN=4.0
# CAPITAL_TREND_INFLOW_WEAK_BUY_RATIO=4.0
# CAPITAL_TREND_INFLOW_WEAK_MIN_MULT=1.5
# 极弱市资金门槛：净流入≥5倍大单门槛、大买/大卖≥5、力度≥2倍
# CAPITAL_TREND_INFLOW_EXTREME_MIN=5.0
# CAPITAL_TREND_INFLOW_EXTREME_BUY_RATIO=5.0
# CAPITAL_TREND_INFLOW_EXTREME_MIN_MULT=2.0
# 持仓净流出：卖方结构过滤；重复提醒仅在流出扩大50%或价格再跌1.5%时触发
# CAPITAL_TREND_HELD_MIN_SELL_RATIO=2.0
# CAPITAL_TREND_HELD_MIN_SELL_SHARE=0.70
# CAPITAL_TREND_HELD_STRENGTHEN_RATIO=1.50
# CAPITAL_TREND_HELD_PRICE_BREAK_PCT=0.015
# CAPITAL_TREND_MAX_HELD_SELL=4

# ==================== Scalping 引擎模式 ====================
# process: 独立子进程运行（本机多核环境推荐，解决单进程瓶颈）
# inline: 单进程运行（服务器单核环境兼容，默认值）
# SCALPING_MODE=process

# ==================== 旧信号链路边界 ====================
# V2 接管期间，旧资金规则只作为观察输入，不得独立广播、推送或交易。
# LEGACY_SIGNAL_MODE=observe
# 旧 BaseStrategy 多策略执行器保持关闭。
# ENABLE_LEGACY_STRATEGY=false

# ==================== 企业微信告警配置 ====================
# 企业微信群机器人 Webhook Key（群聊 → 群机器人 → 添加 → 获取 key）
# WECHAT_WEBHOOK_KEY=your_webhook_key_here

# ==================== Gemini AI 配置 ====================
# Gemini API 密钥（必需，用于新闻智能分析）
# GEMINI_API_KEY=your_api_key_here
# Gemini 模型名称
# GEMINI_MODEL=gemini-3-flash-preview
# 是否启用（有 API key 时默认启用）
# GEMINI_ENABLED=true
# 超时时间（秒）
# GEMINI_TIMEOUT=30

# ==================== Claude AI 配置（官方 anthropic SDK）====================
# 经第三方 Anthropic 兼容代理接入；官方 SDK 自动读取以下两个变量。
# 配置后 AI 分析优先用 Claude，未配置则回退 Gemini。
# 注意：密钥放本文件对应的 .env（已 gitignore），切勿写入被跟踪的 server.env。
# ANTHROPIC_BASE_URL=https://api.ctok.ai
# ANTHROPIC_AUTH_TOKEN=sk-your-token-here
# 可选：覆盖模型（默认 claude-opus-4-8）
# ANTHROPIC_MODEL=claude-opus-4-8

# ==================== CORS 配置 ====================
# 允许的前端来源地址（逗号分隔，默认仅允许 localhost:3000）
# 服务器部署时需改为实际前端域名，如：
# CORS_ORIGINS=http://your-server-ip:3000,https://your-domain.com
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
