# 富途量化交易系统 - 环境变量配置示例
#
# 使用方法：
# 1. 复制此文件为 .env
# 2. 根据实际情况修改配置值
# 3. 环境变量会覆盖 config.json 中的对应配置
#
# 注意：环境变量仅覆盖部署相关的关键配置，不会覆盖所有配置项

# ==================== 连接配置 ====================
# 富途OpenD主机地址
# FUTU_HOST=127.0.0.1

# 富途OpenD端口
# FUTU_PORT=11111

# 数据库路径
# FUTU_DATABASE_PATH=simple_trade/data/trade.db

# ==================== 交易配置 ====================
# 自动交易开关 (true/false, 1/0, yes/no)
# FUTU_AUTO_TRADE=true

# 数据更新间隔（秒）
# FUTU_UPDATE_INTERVAL=60

# ==================== 监控配置 ====================
# 最大订阅股票数量
# FUTU_MAX_SUBSCRIPTION_STOCKS=300

# ==================== Scalping 引擎模式 ====================
# process: 独立子进程运行（本机多核环境推荐，解决单进程瓶颈）
# inline: 单进程运行（服务器单核环境兼容，默认值）
# SCALPING_MODE=process

# ==================== 企业微信告警配置 ====================
# 企业微信群机器人 Webhook Key（群聊 → 群机器人 → 添加 → 获取 key）
# WECHAT_WEBHOOK_KEY=your_webhook_key_here

# ==================== Gemini AI 配置 ====================
# Gemini API 密钥（必需，用于新闻智能分析）
# GEMINI_API_KEY=your_api_key_here
# Gemini 模型名称
# GEMINI_MODEL=gemini-3-flash-preview
# 是否启用（有 API key 时默认启用）
# GEMINI_ENABLED=true
# 超时时间（秒）
# GEMINI_TIMEOUT=30

# ==================== Claude AI 配置（官方 anthropic SDK）====================
# 经第三方 Anthropic 兼容代理接入；官方 SDK 自动读取以下两个变量。
# 配置后 AI 分析优先用 Claude，未配置则回退 Gemini。
# 注意：密钥放本文件对应的 .env（已 gitignore），切勿写入被跟踪的 server.env。
# ANTHROPIC_BASE_URL=https://api.ctok.ai
# ANTHROPIC_AUTH_TOKEN=sk-your-token-here
# 可选：覆盖模型（默认 claude-opus-4-8）
# ANTHROPIC_MODEL=claude-opus-4-8

# ==================== CORS 配置 ====================
# 允许的前端来源地址（逗号分隔，默认仅允许 localhost:3000）
# 服务器部署时需改为实际前端域名，如：
# CORS_ORIGINS=http://your-server-ip:3000,https://your-domain.com
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
