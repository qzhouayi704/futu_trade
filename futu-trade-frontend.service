[Unit]
Description=Futu Trade Frontend (Next.js)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/futu_trade_sys/futu-trade-frontend
Environment=NODE_ENV=production
Environment=FLASK_API_URL=http://127.0.0.1:5001
Environment=PORT=3001
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
